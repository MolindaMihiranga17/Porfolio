---
import { techIcons } from '../data/tech';
const { name } = Astro.props as { name: string };
const base = import.meta.env.BASE_URL;
const icon = techIcons[name];
const url = icon ? `${base}icons/${icon.slug}.svg` : undefined;
---
<span class="chip">
  {url && (icon?.mono
    ? <i class="chip-icon chip-mask" style={`--icon:url(${url})`} aria-hidden="true"></i>
    : <img class="chip-icon" src={url} alt="" width="14" height="14" loading="lazy" decoding="async" />)}
  {name}
</span>

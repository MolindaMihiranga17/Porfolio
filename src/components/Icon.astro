---
const { name = 'arrow', size = 24, class: className = '' } = Astro.props;
const icons: Record<string, string[]> = {
  arrow: ['M5 19 19 5M5 5h14v14'],
  right: ['M3 12h17m-6-6 6 6-6 6'],
  down: ['M12 3v17m-6-6 6 6 6-6'],
  chevron: ['m7 10 5 5 5-5'],
  check: ['m5 12 4 4L19 6'],
  globe: ['M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', 'M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z'],
  mail: ['M3 5h18v14H3z', 'm3 5 9 8 9-8'],
  download: ['M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4'],
  code: ['m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16'],
  search: ['M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Zm-2 5 6 6'],
  pen: ['m4 16-1 5 5-1L21 7l-4-4L4 16Zm10-10 4 4'],
  launch: ['M14 5 21 3l-2 7-8 8-5-5 8-8ZM6 13l-3 1 4-7 5-1m-1 12-1 3 7-4 1-5M4 20l2-2'],
  copy: ['M8 8h12v12H8zM16 8V4H4v12h4'],
  spark: ['M12 1c0 7-4 11-11 11 7 0 11 4 11 11 0-7 4-11 11-11-7 0-11-4-11-11Z'],
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill={name === 'spark' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width={name === 'spark' ? 0 : 1.4} stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">{(icons[name] ?? icons.arrow).map(d => <path d={d} />)}</svg>

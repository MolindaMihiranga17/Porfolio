---
import '../styles/global.css';
import '../styles/reference.css';
import '../styles/motion.css';
const { title = 'Molinda Mihiranga', description = 'Thoughtful interfaces. Robust systems. Selected software engineering work by Molinda Mihiranga, based in Sri Lanka.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const menu = [
  { id: 'experience', name: 'Experience' },
  { id: 'work', name: 'Projects' },
  { id: 'about', name: 'About' },
  { id: 'contact', name: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0d0d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}fonts/display.css`} />
    <link rel="stylesheet" href={`${base}fonts/sans.css`} />
    <link rel="stylesheet" href={`${base}fonts/mono.css`} />
    <title>{title}</title>
  </head>
  <body id="top">
    <div class="page-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Molinda Mihiranga, home">Molinda Mihiranga <span>— Software engineer</span></a>
      <nav class="main-nav" aria-label="Main navigation">{menu.map(item => <a href={`${base}#${item.id}`} data-section={item.id}>{item.name}</a>)}</nav>
      <a class="header-cta" href={`${base}#contact`}>Get in touch</a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} Molinda Mihiranga</span><span>Designed and built by hand.</span><a href="#top">Back to top ↑</a></footer>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>

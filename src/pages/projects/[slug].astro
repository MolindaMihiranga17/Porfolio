---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import GalleryLightbox from '../../components/GalleryLightbox.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${project.title} — Molinda Mihiranga`} description={project.summary}>
  <article class="detail-page">
    <div class="detail-hero section-shell"><a class="back-link" href={`${base}#work`}>← &nbsp; BACK TO WORK</a><div class="detail-heading"><p class="eyebrow"><span class="eyebrow-line"></span> {project.number} / {project.category.toUpperCase()}</p><h1 class:list={[{ 'detail-title-long': project.title.length > 12 }]}>{project.title}<em>.</em></h1><p>{project.summary}</p></div><div class="detail-meta"><div><span>PROJECT TYPE</span><strong>{project.category}</strong></div><div><span>FOCUS</span><strong>{project.eyebrow}</strong></div><div><span>TECHNOLOGIES</span><strong>{project.tags.join(' · ')}</strong></div></div></div>
    <div class="detail-visual-wrap section-shell"><ProjectVisual project={project} /></div>
    <div class="detail-content section-shell"><div class="detail-content-label"><p class="eyebrow"><span class="eyebrow-line"></span> THE WORK</p><h2>What I <em>built.</em></h2></div><div class="detail-highlights">{project.highlights.map((highlight, index) => <div class="detail-highlight reveal"><span>0{index + 1}</span><p>{highlight}</p></div>)}<div class="detail-links">{project.live && <a class="button button-primary" href={project.live} target="_blank" rel="noopener noreferrer">VIEW LIVE SITE <span>↗</span></a>}{project.github && <a class="button button-outline" href={project.github} target="_blank" rel="noopener noreferrer">VIEW CODE <span>↗</span></a>}</div></div></div>
    {project.screenshots && <section class="gallery-section section-shell" aria-labelledby="gallery-title"><div class="gallery-heading"><p class="eyebrow"><span class="eyebrow-line"></span> PROJECT GALLERY</p><h2 id="gallery-title">A closer <em>look.</em></h2><p>Real screens and project photos. Select a screenshot to explore the gallery.</p></div><div class="gallery-grid">{project.screenshots.map((shot, index) => <figure class:list={['gallery-item', `gallery-item-${shot.kind}`, { 'gallery-item-featured': index === 0 && shot.kind === 'desktop' }]}><a href={`${base}${shot.src}`} target="_blank" rel="noopener noreferrer" data-lightbox data-caption={shot.caption} aria-label={`View screenshot: ${shot.caption}`}><img src={`${base}${shot.src}`} alt={shot.alt} loading="lazy" /></a><figcaption><span>{String(index + 1).padStart(2, '0')} / {shot.caption}</span><span aria-hidden="true">↗</span></figcaption></figure>)}</div></section>}
    <a class="next-project" href={`${base}projects/${next.slug}/`}><span>UP NEXT / {next.number}</span><strong>{next.title}<em>.</em></strong><span class="next-arrow">↗</span></a>
  </article>
  {project.screenshots?.length && <GalleryLightbox title={project.title} />}
  <script src="../../scripts/lightbox.ts"></script>
</BaseLayout>

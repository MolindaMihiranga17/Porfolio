---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TechChip from '../components/TechChip.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;

const internship = [
  { title: 'Multi-tenant SaaS web applications', text: 'Designed and built full-stack, multi-tenant SaaS applications with strict tenant isolation, JWT-based authentication, and role-based access control across multiple user roles, each with its own dashboard.' },
  { title: 'Core business modules, end to end', text: 'Developed member and user management, subscriptions, scheduling, attendance tracking, billing, payments, and financial record keeping.' },
  { title: 'Third-party integrations', text: 'Integrated payment gateways, SMS and email notifications, secure cloud file storage with AWS S3 presigned URLs, and AI-powered features through external APIs.' },
  { title: 'Real-time features and audit logging', text: 'Built live updates with Socket.IO, automated notifications, and audit logging systems that track key user and system activity.' },
  { title: 'Reporting and dashboards', text: 'Implemented PDF and Excel reporting along with data visualisation dashboards for financial, attendance, and inventory data.' },
  { title: 'Maintainable, type-safe architecture', text: 'Applied Server Actions, dedicated data-access layers, Zod validation, and reusable UI components to keep the codebase clean and safe to extend.' },
];
const stack = ['React', 'Next.js', 'TypeScript', 'Node.js', 'Express.js', 'MongoDB', 'Mongoose', 'Socket.IO', 'JWT', 'Zod', 'Tailwind CSS', 'AWS S3'];
const skillGroups = [
  { name: 'Languages', items: ['Java', 'C', 'C++', 'JavaScript', 'TypeScript', 'Go', 'Python', 'PHP', 'Kotlin', 'SQL'] },
  { name: 'Web & mobile', items: ['React', 'React Native', 'Next.js', 'Express.js', 'Node.js', 'ASP.NET Core', 'Spring Boot', 'FastAPI'] },
  { name: 'Database & messaging', items: ['PostgreSQL', 'MongoDB', 'MySQL', 'Redis', 'Apache Kafka'] },
  { name: 'Cloud & infra', items: ['Docker', 'Kong', 'Cloudflare R2', 'AWS', 'GitHub Actions'] },
  { name: 'Tools', items: ['Git', 'R Studio', 'Power BI', 'Trello', 'Jira', 'Playwright'] },
];
const email = 'molindamihiranga17@gmail.com';
---
<BaseLayout>
  <section class="hero section-shell" id="intro" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><i></i> Open to opportunities</p>
          <h1 id="hero-title">Molinda<br />Mihiranga<br /><span>Software engineer.</span></h1>
          <p class="hero-lead"><strong>Thoughtful interfaces on solid systems.</strong> I’m an IT undergraduate at SLIIT based in Sri Lanka, building full-stack products from the first idea to something that works.</p>
          <div class="hero-actions"><a class="btn btn-solid" href="#work">View projects</a><a class="btn" href={`${base}resume/Molinda-Mihiranga-CV.pdf`} download>Download CV <Icon name="download" size={15} /></a></div>
        </div>
        <figure class="hero-portrait"><img src={`${base}images/molinda-portrait.webp`} alt="Portrait of Molinda Mihiranga" width="640" height="667" fetchpriority="high" decoding="async" /><figcaption>Colombo, Sri Lanka</figcaption></figure>
      </div>
      <dl class="facts">
        <div><dt>6 months</dt><dd>Software engineering internship at Raxwo</dd></div>
        <div><dt>{projects.length} projects</dt><dd>Built end to end, from architecture to deployment</dd></div>
        <div><dt>BSc IT</dt><dd>Sri Lanka Institute of Information Technology</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section-shell" id="experience" aria-labelledby="experience-title">
    <div class="wrap">
      <div class="section-head reveal"><p class="eyebrow">Experience</p><div><h2 id="experience-title">What I did as an intern.</h2><p>Six months of production work on multi-tenant business software, across the database, the API and the interface.</p></div></div>
      <div class="exp">
        <div class="exp-meta reveal">
          <span class="dates">Apr — Oct 2026</span>
          <h3>Software Engineering Intern</h3>
          <span class="company">Raxwo Pvt Ltd</span>
          <span class="place">Remote · Sri Lanka</span>
          <div class="chips">{stack.map(s => <TechChip name={s} />)}</div>
        </div>
        <div class="exp-list">{internship.map((item, index) => <div class="exp-item reveal"><span>{String(index + 1).padStart(2, '0')}</span><div><h4>{item.title}</h4><p>{item.text}</p></div></div>)}</div>
      </div>
    </div>
  </section>

  <section class="section section-shell" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head reveal"><p class="eyebrow">Projects</p><div><h2 id="work-title">Selected work.</h2><p>Different problems, one approach: build something useful, and build it well.</p></div></div>
      <div class="projects">{projects.map(project => {
        const phone = project.visual === 'hydro' || project.visual === 'spendwise';
        const shots = (project.screenshots ?? []).slice(0, phone ? 2 : 1);
        const href = `${base}projects/${project.slug}/`;
        return <article class="project reveal">
          <a class:list={['project-media', { 'is-phone': phone, 'is-placeholder': shots.length === 0 }]} href={href} aria-label={`Open ${project.title}`}>{shots.length > 0
            ? <div class="frame">{shots.map(shot => <img src={`${base}${shot.src}`} alt={shot.alt} loading="lazy" decoding="async" />)}</div>
            : <div class="placeholder"><span>{project.eyebrow}</span><strong>{project.title}</strong><div class="type-lines"><i></i><i></i><i></i><i></i></div><span>{project.status ?? 'In progress'} · screenshots coming soon</span></div>}</a>
          <div class="project-copy">
            <p class="eyebrow"><span>{project.number}</span><span>{project.category}</span>{project.status && <span class="status-pill">{project.status}</span>}</p>
            <h3><a href={href}>{project.title}</a></h3>
            <p>{project.summary}</p>
            <div class="chips">{project.tags.slice(0, 5).map(tag => <TechChip name={tag} />)}</div>
            <a class="link" href={href}>Read the case study <Icon name="right" size={15} /></a>
          </div>
        </article>;
      })}</div>
      <div class="work-endnote"><span>More experiments and source code on GitHub.</span><a class="link" href="https://github.com/MolindaMihiranga17" target="_blank" rel="noopener noreferrer">github.com/MolindaMihiranga17 <Icon name="arrow" size={14} /></a></div>
    </div>
  </section>

  <section class="section section-shell" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="about">
        <p class="eyebrow reveal">About</p>
        <div class="reveal">
          <div class="about-copy">
            <h2 id="about-title" style="font:500 clamp(30px,3.4vw,44px)/1.15 'DM Sans';letter-spacing:-.02em;color:var(--ink)">A curious mind and a practical builder.</h2>
            <p>I enjoy the space where a good idea meets the details that make it work. I’m most at home working across the whole stack: the interface people touch, the API behind it, and the data and infrastructure underneath.</p>
            <p>Outside of coursework I build real products, from <strong>AI-assisted recruitment</strong> to <strong>connected agriculture</strong> and <strong>personal finance</strong>, and I care about shipping things that are both pleasant to use and solid under the hood.</p>
          </div>
          <div class="about-cols">
            <div class="edu"><h4>Education</h4><strong>BSc in Information Technology</strong><span>Sri Lanka Institute of Information Technology, Malabe · 2022 — present</span><strong style="margin-top:18px">Science stream (Mathematics)</strong><span>Badulla Central College · 2013 — 2021</span></div>
            <div>{skillGroups.map(group => <div class="skill-group"><h4>{group.name}</h4><div class="chips">{group.items.map(item => <TechChip name={item} />)}</div></div>)}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact section-shell" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Let’s talk.</h2>
      <p>A project, an opportunity or a good idea. It all starts with a conversation.</p>
      <a class="email-link" href={`mailto:${email}`}>{email} <Icon name="arrow" size={22} /></a>
      <div class="contact-actions"><button class="copy-email" type="button" data-email={email}><Icon name="copy" size={14} /> Copy email</button><span class="copy-status" role="status" aria-live="polite"></span></div>
      <div class="social-links"><a href="https://github.com/MolindaMihiranga17" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://www.linkedin.com/in/molinda-mihiranga-627789317" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={`${base}resume/Molinda-Mihiranga-CV.pdf`} download>Résumé</a></div>
    </div>
  </section>
</BaseLayout>

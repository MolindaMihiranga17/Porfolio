---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="cover" id="intro" aria-labelledby="hero-title">
    <picture class="cover-portrait">
      <source srcset={`${base}images/molinda-desktop.webp`} media="(min-width: 761px)" type="image/webp" />
      <img src={`${base}images/molinda.png`} alt="Portrait of Molinda Mihiranga" width="640" height="667" fetchpriority="high" decoding="async" />
    </picture>
    <div class="cover-shade" aria-hidden="true"></div>
    <div class="cover-top"><span>INDEPENDENT MIND.<br />CONNECTED THINKING.</span><span>WEB / MOBILE / SYSTEMS</span></div>
    <span class="cover-edge" aria-hidden="true">A PERSONAL COLLECTION OF WORK — 01 / 05</span>
    <div class="cover-bottom"><p class="cover-role"><span></span> SOFTWARE ENGINEER & BUILDER</p><h1 id="hero-title">MOLINDA<br /><span>MIHIRANGA.</span></h1><div class="cover-description"><p>From the first idea to the final interaction.<br />I build software that makes things happen.</p><a href="#work" class="cover-scroll" aria-label="Explore selected work"><span>EXPLORE<br />MY WORK</span><b>↓</b></a></div></div>
  </section>
  <div class="intro-strip reveal"><span>BASED IN SRI LANKA</span><span class="strip-line"></span><span>BUILT FOR THE REAL WORLD</span><span class="strip-symbol" aria-hidden="true">✳</span></div>
  <section class="work-section section-shell" id="work" aria-labelledby="work-title"><div class="chapter-heading reveal"><p class="eyebrow">02 / SELECTED WORK</p><h2 id="work-title">THINGS I’VE<br /><span>PUT INTO MOTION.</span></h2><p>Recruitment. Agriculture. Finance.<br />Different challenges. End-to-end thinking.</p></div><div class="work-index">{projects.map((project,index) => <details class="work-entry reveal" name="selected-project" open={index===0}><summary><span class="entry-number">{project.number}</span><h3>{project.title}</h3><span class="entry-category">{project.category}</span><span class="entry-indicator" aria-hidden="true">+</span></summary><div class="entry-panel"><div class="entry-image"><ProjectVisual project={project} /></div><div class="entry-content"><p class="eyebrow">{project.eyebrow}</p><p class="entry-description">{project.summary}</p><div class="tag-row">{project.tags.slice(0,5).map(tag=><span>{tag}</span>)}</div><a class="project-link" href={`${base}projects/${project.slug}/`}>EXPLORE PROJECT <span>↗</span></a></div></div></details>)}</div></section>
  <section class="profile-section section-shell" id="about" aria-labelledby="about-title"><div class="profile-label"><p class="eyebrow">03 / A BIT OF CONTEXT</p><span class="profile-symbol" aria-hidden="true">↳</span></div><div class="profile-main"><h2 id="about-title" class="reveal">I LIKE THE POINT<br />WHERE <span>“WHAT IF”</span><br />BECOMES <span>“IT WORKS.”</span></h2><div class="profile-copy reveal"><p>I’m Molinda, a software engineer and Information Technology undergraduate at SLIIT. I work across interfaces, APIs, mobile apps, and the systems underneath.</p><p>My internship at Raxwo took me into the details of building multi-tenant platforms for gyms and learning institutes. My other projects connect AI with recruitment, IoT with agriculture, and everyday spending with better insights.</p></div><div class="resume-action reveal"><a class="button button-primary" href={`${base}resume/Molinda-Mihiranga-CV.pdf`} download>DOWNLOAD CV <span aria-hidden="true">&darr;</span></a><span>PDF &middot; Experience, projects &amp; skills</span></div><div class="cv-experience reveal"><p class="eyebrow">EXPERIENCE / APRIL 13 &mdash; OCTOBER 13, 2026</p><h3>Software Engineering Intern</h3><p class="cv-employer">Raxwo Pvt Ltd &middot; Remote, Sri Lanka</p><p>Built multi-tenant software for gym operations and tuition institutes, working across user interfaces, backend services, access control, payments, reporting, and real-time updates.</p><div class="cv-role-projects"><a href={`${base}projects/gymora/`}><strong>Gymora &nearr;</strong><span>Memberships, coaching, POS, inventory, PayHere payments, and automated notifications.</span></a><a href={`${base}projects/raxwolms/`}><strong>RaxwoLMS &nearr;</strong><span>Academic workflows, institute finance, tenant isolation, secure storage, and reporting.</span></a></div></div><div class="cv-education reveal"><p class="eyebrow">EDUCATION</p><div class="experience-grid"><article><span class="eyebrow">2022 &mdash; PRESENT</span><h3>Bachelor of Science in Information Technology</h3><p>Sri Lanka Institute of Information Technology (SLIIT)</p><p>Specialized in IT &middot; Malabe, Sri Lanka</p></article><article><span class="eyebrow">2013 &mdash; 2021</span><h3>Science Stream (Mathematics)</h3><p>Badulla Central College</p><p>Badulla, Sri Lanka</p></article></div></div><div class="toolkit reveal"><p class="eyebrow">TECHNICAL SKILLS</p><div><span>Languages</span><p>Java / C / C++ / JavaScript / TypeScript / Go / Python / PHP / Kotlin / SQL</p></div><div><span>Web &amp; mobile</span><p>React.js / React Native / Next.js / Express.js / Node.js / ASP.NET Core / Spring Boot / FastAPI</p></div><div><span>Databases &amp; messaging</span><p>PostgreSQL / MongoDB / MySQL / Redis / Apache Kafka</p></div><div><span>Cloud &amp; infrastructure</span><p>Docker / Kong / Cloudflare R2 / AWS / GitHub Actions</p></div><div><span>Developer tools</span><p>Git / R Studio / PowerBI / Trello / Jira / Playwright</p></div></div></div></section>
  <section class="contact-block section-shell" id="contact" aria-labelledby="contact-title"><div class="contact-top"><p class="eyebrow">04 / MAKE THE CONNECTION</p><span aria-hidden="true">↗</span></div><h2 id="contact-title" class="reveal">GOOD WORK<br />STARTS WITH<br /><span>A CONVERSATION.</span></h2><div class="contact-actions reveal"><a href="mailto:molindamihiranga17@gmail.com">molindamihiranga17@gmail.com ↗</a><button class="copy-email" type="button" data-email="molindamihiranga17@gmail.com">COPY EMAIL ⧉</button><span class="copy-status" role="status"></span></div><div class="contact-links reveal"><p>Have a project, an opportunity, or a question?<br />I’d like to hear it.</p><div><a href="https://github.com/MolindaMihiranga17" target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href="https://www.linkedin.com/in/molinda-mihiranga-627789317" target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a></div></div></section>
</BaseLayout>
